# ─── Site URL ────────────────────────────────────────────────────────────────
# The canonical production URL. Used for sitemap, metadata, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://usmosques.com

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# Obtain your Measurement ID from:
#   Google Analytics → Admin → Data Streams → Web → Measurement ID
# The value must start with "G-".
# Leave blank (or omit) in local development to suppress GA4.
# In Railway: set this in Project → Variables, then redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE_WITH_REAL_ID
